    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select b.id_whatsapp, a.*\n  from public.tb_lembretes a,\n       public.tb_clientes b\n where a.id_cliente = b.id\n   and a.dt_proxima_exec >= DATE_TRUNC('day',CURRENT_DATE)\n   and a.dt_proxima_exec <= DATE_TRUNC('day',CURRENT_DATE + 3)\n   and a.abortar_execucao_lembrete is null\n   and (a.dt_desativacao is null OR a.dt_desativacao >= CURRENT_DATE)\n   and (a.dt_envio_fila is null or a.dt_envio_fila < a.dt_ultima_exec)\n   and a.status_envio_fila = 'P'",
        "options": {}
