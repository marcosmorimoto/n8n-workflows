    {
      "parameters": {
        "jsCode": "// Script simplificado para n8n - Extração de data_proxima_execucao, data_desativacao e descricao\n\n// Obtém o texto de entrada do item\nconst texto = $input.first().json.output || $input.first().json.output || '';\n\n// Função para extrair valores de forma segura\nfunction extrairCampo(texto, nomeCampo) {\n  try {\n    // Normaliza o texto removendo múltiplos espaços mas mantendo quebras de linha\n    const textoLimpo = texto.replace(/\\r/g, '');\n    \n    // Cria regex para capturar o valor do campo\n    // Procura pelo nome do campo seguido de : e captura até o próximo campo ou fim\n    const regex = new RegExp(\n      `${nomeCampo}:\\\\s*([^\\\\n]*?)(?=\\\\s*(?:data_proxima_execucao|data_desativacao|descricao):|$)`,\n      'si'\n    );\n    \n    const match = textoLimpo.match(regex);\n    \n    if (match && match[1] !== undefined) {\n      // Remove espaços extras e retorna o valor\n      return match[1].trim();\n    }\n    \n    return '';\n  } catch (error) {\n    console.error(`Erro ao extrair ${nomeCampo}:`, error);\n    return '';\n  }\n}\n\ntry {\n  // Extrai os três campos\n  const data_proxima_execucao = extrairCampo(texto, 'data_proxima_execucao');\n  const data_desativacao = extrairCampo(texto, 'data_desativacao');\n  const descricao = extrairCampo(texto, 'descricao');\n  \n  // Monta o objeto de saída\n  const resultado = {\n    data_proxima_execucao: data_proxima_execucao || null,\n    data_desativacao: data_desativacao || null,\n    descricao: descricao || null\n  };\n  \n  // Adiciona informações extras úteis\n  if (data_proxima_execucao) {\n    try {\n      const dataObj = new Date(data_proxima_execucao);\n      resultado.data_proxima_valida = !isNaN(dataObj.getTime());\n      if (resultado.data_proxima_valida) {\n        resultado.data_proxima_formatada = dataObj.toISOString();\n      }\n    } catch (e) {\n      resultado.data_proxima_valida = false;\n    }\n  }\n  \n  if (data_desativacao) {\n    try {\n      const dataObj = new Date(data_desativacao);\n      resultado.data_desativacao_valida = !isNaN(dataObj.getTime());\n      if (resultado.data_desativacao_valida) {\n        resultado.data_desativacao_formatada = dataObj.toISOString();\n      }\n    } catch (e) {\n      resultado.data_desativacao_valida = false;\n    }\n  }\n  \n  // Retorna o resultado\n  return resultado;\n  \n} catch (error) {\n  // Em caso de erro, retorna objeto com erro\n  return {\n    erro: true,\n    mensagem: error.message,\n    data_proxima_execucao: null,\n    data_desativacao: null,\n    descricao: null\n  };\n}"
      },
