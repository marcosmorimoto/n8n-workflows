    {
      "parameters": {
        "jsCode": "const input = $input.first().json.output;\n\n// 1. Remove os blocos ```sql e ```\nlet clean = input\n   .replace(/^```sql\\s*|\\s*```$/gi, '')\n   .replace(/```/g, '')\n   .replace(/\\n/g, ' ')\n   .replace(/\\s+/g, ' ')\n   .trim();\n\n\nreturn { \n  json: { \n    sql_query: clean \n  } \n};"
      },
