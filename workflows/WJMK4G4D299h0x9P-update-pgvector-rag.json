        "query": "SELECT \n  COALESCE(t.qtd, 0) as qtd, \n  t.id_pgvector \nFROM \n  (\n    -- Tabela \"base\" que sempre tem 1 linha\n    SELECT 1 as dummy\n  ) as base \n  LEFT JOIN (\n    -- Sua query original exata vai aqui\n    SELECT \n      count(*) qtd, \n      id id_pgvector, \n      1 as dummy \n    FROM \n      tb_detalhe_stores \n    WHERE \n      metadata @> '{\"id_store\": \"{{ $('dados_por_id_stores').item.json.id_store }}\"}'::jsonb \n    GROUP BY \n      id \n    LIMIT \n      1\n  ) as t ON base.dummy = t.dummy",
        "options": {}
