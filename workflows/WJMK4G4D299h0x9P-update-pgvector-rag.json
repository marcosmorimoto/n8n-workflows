        "query": "select '{{ $json.dados_estabelecimento }}' dados_estabelecimento\nunion\nselect 'Produto: ' || replace(name, ';', '') || ' - ' || replace(description, ';', '') || ' - ' || price || '.' dados_estabelecimento\n  from products\n where store_id = '{{ $json.id_store }}'\n   and active = true",
