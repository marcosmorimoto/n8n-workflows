    {
      "parameters": {
        "jsCode": "// Recuperar contador global\nconst staticData = $getWorkflowStaticData('global');\nlet contador = staticData.semMudancas || 0;\n\n// Incrementar pelo número de itens\ncontador += $input.all().length;\n\n// Salvar\nstaticData.semMudancas = contador;\n\n// Retornar todos os itens com o contador\nreturn $input.all().map(item => ({\n  json: {\n    ...item.json,\n    semMudancasTotal: contador\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
