    {
      "parameters": {
        "functionCode": "// Preparar workflows e limpar credenciais\nconst workflows = items.map(item => {\n  const workflow = item.json;\n  \n  // Criar cópia para não modificar original\n  const cleanWorkflow = JSON.parse(JSON.stringify(workflow));\n  \n  // Limpar dados sensíveis\n  if (cleanWorkflow.nodes) {\n    cleanWorkflow.nodes = cleanWorkflow.nodes.map(node => {\n      if (node.credentials) {\n        Object.keys(node.credentials).forEach(credType => {\n          node.credentials[credType] = {\n            id: 'REMOVED',\n            name: node.credentials[credType].name\n          };\n        });\n      }\n      return node;\n    });\n  }\n  \n  // Adicionar metadados\n  cleanWorkflow.backupMetadata = {\n    backedUpAt: new Date().toISOString(),\n    version: workflow.updatedAt || workflow.createdAt,\n    originalId: workflow.id\n  };\n  \n  const fileName = workflow.name\n    .replace(/[^a-z0-9]/gi, '-')\n    .toLowerCase()\n    .replace(/-+/g, '-')  // Remove múltiplos hífens\n    .replace(/^-|-$/g, ''); // Remove hífens no início/fim\n  \n  // Use apenas o ID numérico se disponível\n  const workflowId = workflow.id || 'unknown';\n  \n  return {\n    json: {\n      path: `workflows/${workflowId}-${fileName}.json`,\n      content: JSON.stringify(cleanWorkflow, null, 2),\n      name: workflow.name,\n      id: workflowId,\n      // ...\n    }\n  };\n});\n\nreturn workflows;"
      },
