    {
      "parameters": {
        "jsCode": "// Recuperar as mesmas estatísticas\nconst staticData = $getWorkflowStaticData('global');\n\n// Usar os valores\nlet qtdNovos = 0;\nlet qtdAtualizados = 0;\nlet qtdSemMudancas = 0;\n\ntry { qtdNovos = $('Qtd Novos').first().json.criadosTotal || 0; } catch {}\ntry { qtdAtualizados = $('Qtd Atualizados').first().json.atualizadosTotal || 0; } catch {}\ntry { qtdSemMudancas = $('Qtd Não Atualizados').first().json.semMudancasTotal || 0; } catch {}\n\n// Limpar tudo do staticData \nObject.keys(staticData).forEach(key => {\n  delete staticData[key];\n});\n\nreturn {\n  json: {\n    qtdNovos,\n    qtdAtualizados,\n    qtdSemMudancas,\n    timestamp: new Date().toISOString()\n  }\n};\n"
      },
