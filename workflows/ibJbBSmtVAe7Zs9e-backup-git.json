    {
      "parameters": {
        "functionCode": "// Contar mudanças\nconst stats = {\n  total: 0,\n  criados: 0,\n  atualizados: 0,\n  semMudancas: 0\n};\n\n// Acessar todas as execuções do split batch\nconst allRuns = $items(\"Detectar mudanças\", 0, -1);\n\nallRuns.forEach(item => {\n  stats.total++;\n  if (item.json.changed) {\n    if (item.json.action === 'create') {\n      stats.criados++;\n    } else {\n      stats.atualizados++;\n    }\n  } else {\n    stats.semMudancas++;\n  }\n});\n\nreturn {\n  json: {\n    resumo: `Backup concluído: ${stats.criados} novos, ${stats.atualizados} atualizados, ${stats.semMudancas} sem mudanças`,\n    stats,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
