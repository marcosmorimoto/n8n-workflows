        -912,
        560
      ],
      "id": "fed27424-1557-42f0-9309-3e63ed914ec6",
      "webhookId": "6f8792b5-25f3-4af5-b14a-93c0b53002d7",
      "credentials": {
        "githubApi": {
          "id": "REMOVED",
          "name": "GitHub account"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "functionCode": "// Verificar se o arquivo mudou\nconst newContent = $json.content;\nconst path = $json.path;\nconst workflowName = $json.name;\n\n// CORREÇÃO: Verificar se o node anterior teve erro\nconst githubFile = $node[\"Buscar arquivo atual\"].json;\nconst hasError = $node[\"Buscar arquivo atual\"].error !== undefined;\n\n// Se arquivo não existe no GitHub, precisa criar\nif (hasError || !githubFile || !githubFile.sha) {\n  return {\n    json: {\n      ...items[0].json,\n      action: 'create',\n      changed: true,\n      reason: 'Arquivo novo'\n    }\n  };\n}\n\n// Se existe, comparar conteúdo\nconst existingContent = githubFile.content ? \n  Buffer.from(githubFile.content, 'base64').toString('utf8') : \n  '';\n\n// Comparar apenas o conteúdo relevante (ignorar backupMetadata)\nconst parseContent = (content) => {\n  try {\n    const parsed = JSON.parse(content);\n    delete parsed.backupMetadata;\n    return JSON.stringify(parsed, null, 2);\n  } catch (e) {\n    return content;\n  }\n};\n\nconst existingNormalized = parseContent(existingContent);\nconst newNormalized = parseContent(newContent);\n\n// Verificar se mudou\nconst changed = existingNormalized !== newNormalized;\n\nreturn {\n  json: {\n    ...items[0].json,\n    action: githubFile.sha ? 'update' : 'create',\n    changed: changed,\n    sha: githubFile.sha || '',\n    reason: changed ? 'Conteúdo modificado' : 'Sem mudanças'\n  }\n};"
      },
