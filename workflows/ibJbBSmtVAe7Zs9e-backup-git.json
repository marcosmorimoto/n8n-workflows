    {
      "parameters": {
        "functionCode": "// Contar mudanças\nconst stats = {\n  total: 0,\n  criados: 0,\n  atualizados: 0,\n  semMudancas: 0\n};\n\n// Acessar todas as execuções do split batch\nconst allRuns = $items(\"Processar um por vez\", 0, -1);\n\nallRuns.forEach(item => {\n  stats.total++;\n  if (item.json.changed) {\n    if (item.json.action === 'create') {\n      stats.criados++;\n    } else {\n      stats.atualizados++;\n    }\n  } else {\n    stats.semMudancas++;\n  }\n});\n\nreturn {\n  json: {\n    resumo: `Backup concluído: ${stats.criados} novos, ${stats.atualizados} atualizados, ${stats.semMudancas} sem mudanças`,\n    stats,\n    timestamp: new Date().toISOString()\n  }\n};"
      },
      "name": "Resumo final",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        -864,
        352
      ],
      "id": "3ee67d21-3b20-4b52-8da9-125018be61f6"
    },
    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n  // Decodificar conteúdo do GitHub\nconst githubFile = $input.item.json;\n\n// Se não tem conteúdo, retornar como está\nif (!githubFile.content) {\n  return {\n    ...githubFile,\n    decodedContent: null,\n    hasContent: false\n  };\n}\n\ntry {\n  // Decodificar Base64 para string\n  const decodedString = Buffer.from(githubFile.content, 'base64').toString('utf8');\n  \n  // Converter string para JSON\n  const jsonContent = JSON.parse(decodedString);\n  \n  // Retornar com o conteúdo decodificado\n  return {\n    ...githubFile,\n    decodedContent: jsonContent,\n    hasContent: true,\n    // Extrair campos principais para fácil acesso\n    git_updatedAt: jsonContent.updatedAt,\n    git_createdAt: jsonContent.createdAt,\n    git_name: jsonContent.name,\n    git_id: jsonContent.id,\n    git_active: jsonContent.active,\n    git_isArchived: jsonContent.isArchived || false\n  };\n  \n} catch (error) {\n  // Se falhar, retornar com erro\n  return {\n    ...githubFile,\n    decodedContent: null,\n    hasContent: false,\n    decodeError: error.message\n  };\n}\n}\n\nreturn $input.all();"
      },
